# Sistema
.DS_Store

# Segredos
.env
.env.*
!.env.example
env
**/env

# Dependências
node_modules/

# Protótipo: PostgreSQL embutido e artefactos locais do protótipo
.pgdata*/
*.db
*.db-journal
.zcode/
.conversas.json
.ultimo_chat

# Vídeos: binários pesados e gerados (renders, áudio, frames, caches)
videos/**/renders/
videos/**/audio/
videos/**/frames/
videos/**/.media/
videos/**/.thumbnails/
videos/**/.hyperframes/
*.mp4
*.mov
*.mp3
*.wav
*.m4a

# Python
__pycache__/
*.pyc
.neon
