{
  "name": "delegate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protótipo Delegate — Câmara sem burocracia (Hack4Guimarães 2035)",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "nucleo": "tsx --env-file=.env apps/api/src/nucleo/principal.ts",
    "porta": "tsx apps/api/src/porta/principal.ts",
    "provar:postgres": "tsx scripts/provar-postgres.ts",
    "legendas": "cp packages/eventos/src/legendas.json ../site/legendas.json",
    "test": "vitest run && npm run t:texto",
    "t:testes": "vitest run && npm run t:texto",
    "registo:validar": "tsx scripts/validar-registo.ts",
    "avaliar": "tsx avaliacao/executor.ts",
    "demo:repor": "tsx scripts/repor-demo.ts",
    "ingerir": "tsx --env-file=.env scripts/ingerir-conhecimento.ts",
    "t:texto": "tsx scripts/varrer-texto.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@delegate/eventos": "*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
