# Exemplo de configuração do protótipo Delegate.
# Copia para `.env` e preenche. O `.env` nunca vai para o repositório.
#
#   cp .env.example .env
#
# Só a primeira é obrigatória. As restantes têm valor por omissão no código,
# para que o protótipo arranque sem segredos — só a que aponta para o exterior
# (o token do Telegram) não tem omissão possível.

# Token do bot, ao @BotFather. Única variável sem valor por omissão:
# sem ela o núcleo não arranca (npm run nucleo / npm run ouvir).
TELEGRAM_BOT_TOKEN=

# Nome da sessão: distingue os dados de uma demonstração dos da anterior.
# Por omissão 'demo'. Não apagues a base entre demonstrações sem trocar isto,
# senão a segunda vê a história da primeira.
SESSAO=

# Endereço MCP da Porta Agêntica. Por omissão http://127.0.0.1:4001/mcp.
# É o núcleo a falar com a porta pela rede, como cliente — a fronteira é o produto.
PORTA_MCP_URL=

# Porta HTTP da Porta Agêntica. Por omissão 4001.
PORTA_HTTP_PORT=

# Porto do PostgreSQL embutido. Por omissão 5433.
PGPORT=

# Segredo mestre do Cofre Digital (AES-256-GCM). Por omissão uma constante no
# código, o que serve para um protótipo descartável e não serve para mais nada:
# define-a para que o cofre não partilhe estado entre arranques.
COFRE_SEGREDO_MESTRE=

# OpenRouter (API única de IA para TypeSafe Jev 'typesafe/jev-router' e Redação Conversacional - ADR-024)
OPEN_ROUTER_API_TOKEN=

# Cloudflare (Embeddings vetoriais / RAG)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Canal Web do painel (sessões ligadas por QR ao Telegram). Com '1', os códigos
# de ligação ficam associados de imediato à pessoa de demonstração — útil para
# testar o painel e para correr noutra máquina sem telemóvel. Por omissão '0':
# cada sessão só interage depois de /start <código> no Telegram (é isso que
# autentica a pessoa).
CANAL_WEB=

# Implantação alojada (Vercel): se esta variável existir, o núcleo usa a base
# externa (Neon/Vercel Postgres) em vez do PostgreSQL embutido, e as funções
# api/ do Vercel ficam ativas. Sem ela, tudo corre local como sempre.
DATABASE_URL=
